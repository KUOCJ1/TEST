# ── 環境變數（Hostinger：hPanel → Node.js 應用 → Environment variables 逐項填入）──
# 若主機不能在面板設定，就把這個檔複製成「.env」（檔名就是 .env）放在應用根目錄並填值；
# 安裝包的啟動指令（npm start）已設定成「有 .env 就讀」。
# 絕對不要把填好的 .env 寄給別人、貼到對話或放進公開的地方。

# 必填：登入簽章密鑰，至少 32 字元的隨機字串（可用密碼產生器產生）
JWT_SECRET=

# 必填：管理員帳號（只有資料庫還沒有管理員時，第一次啟動才會用它建立）
ADMIN_EMAIL=
ADMIN_PASSWORD=

NODE_ENV=production

# 由這支程式一併提供前端畫面（本安裝包的 public 資料夾）
STATIC_DIR=./public

# 資料庫位置。重要：請放在「重新部署也不會被清掉」的位置（見安裝說明第 5 節），
# 實際檔案會是這個路徑再加 .sqlite3
DB_PATH=./data/db.json

# 網站網址（信件裡的連結用），例如 https://assess.你的網域.com
APP_URL=

# 安全標頭 CSP：report-only（預設，只回報不擋）／enforce（正式啟用）／off。
# 建議先用預設，把各功能走一遍確認瀏覽器主控台沒有違規，再改 enforce。
CSP_MODE=report-only

# 反向代理層數：Hostinger 前面通常有 1 層，先設 1；部署後請從外部網路確認
TRUST_PROXY=1

# 埠號：Hostinger 會自動指定，通常不用填

# ── 選填：寄信（三項都填才啟用；沒填就不寄信，其他功能不受影響）──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── 選填：AI 小幫手 ──
OPENROUTER_API_KEY=
